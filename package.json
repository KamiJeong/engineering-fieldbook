{
  "name": "engineering-fieldbook",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun site/scripts/dev.ts",
    "docs:validate": "python3 skills/refresh-fieldbook/scripts/fieldbook.py audit && bun site/scripts/generate.ts",
    "lint": "bun --bun node_modules/eslint/bin/eslint.js site vite.config.ts playwright.config.ts --max-warnings 0",
    "typecheck": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test site/tests",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "build": "bun site/scripts/build.ts",
    "preview": "bun site/scripts/serve.ts",
    "verify": "bun run docs:validate && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "browser:install": "node node_modules/@playwright/test/cli.js install chromium",
    "format": "bun --bun node_modules/prettier/bin/prettier.cjs --write site vite.config.ts playwright.config.ts package.json tsconfig.json eslint.config.js .github/workflows/pages.yml"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-rehype": "11.1.2",
    "rehype-sanitize": "6.0.0",
    "rehype-highlight": "7.0.2",
    "rehype-stringify": "10.0.1",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "unist-util-visit": "5.0.0",
    "yaml": "2.9.0",
    "mermaid": "11.17.2",
    "dompurify": "3.4.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.9",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.6"
  }
}
